# Kopirajte ovu datoteku u .env i upišite ključ.
# Bez ključa bot radi u simuliranom modu (pravila + predlošci).
ANTHROPIC_API_KEY=

# Opcionalno: koji model koristiti (zadano: claude-opus-5-5).
# Jeftinije opcije: claude-sonnet-5-5, claude-haiku-4-5
ANTHROPIC_MODEL=

# Opcionalno: Redis za spremanje razgovora web chata (docker compose up -d).
# Bez ovoga se razgovori drže u memoriji servera i nestaju kod restarta.
REDIS_URL=
